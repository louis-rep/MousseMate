# Port 5433 (host) maps to 5432 inside Docker, avoiding conflicts with a local Postgres on 5432
# Use @db:5432 inside Docker Compose (api container)
DATABASE_URL=postgresql://moussemate:moussemate@127.0.0.1:5433/moussemate
TEST_DATABASE_URL=postgresql://moussemate:moussemate@127.0.0.1:5434/moussemate_test
ALLOWED_ORIGINS=["http://localhost:5173"]
DEBUG=true
